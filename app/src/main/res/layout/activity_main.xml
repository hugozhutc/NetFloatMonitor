<?xml version="1.0" encoding="utf-8"?>
<LinearLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="NetFloat Monitor"
        android:textStyle="bold"
        android:textSize="24sp" />

    <EditText
        android:id="@+id/editIp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:hint="目标IP"
        android:text="192.168.1.100" />

    <EditText
        android:id="@+id/editPort"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:hint="UDP端口"
        android:inputType="number"
        android:text="14550" />

    <!-- 新增：功能开关控制区 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:background="#F5F5F5"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[ 功能控制开关 ]"
            android:textStyle="bold"
            android:textColor="#666666"
            android:textSize="12sp" />

        <Switch
            android:id="@+id/switchFloat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="开启悬浮窗"
            android:textSize="14sp" />

        <Switch
            android:id="@+id/switchChart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="启用实时曲线图"
            android:textSize="14sp" />

        <Switch
            android:id="@+id/switchLogging"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="启用 CSV 日志导出"
            android:textSize="14sp" />
    </LinearLayout>

    <Button
        android:id="@+id/startBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="启动监控" />

    <Button
        android:id="@+id/stopBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="停止监控" />

    <Button
        android:id="@+id/clearBtn"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="清除日志" />

    <!-- 实时状态监控区面板 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:background="#F5F5F5"
        android:padding="12dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="[ 实时状态面板 ]"
            android:textStyle="bold"
            android:textColor="#666666"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/tvStatusInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="#333333"
            android:textSize="14sp"
            android:lineSpacingMultiplier="1.2"
            android:text="链路状态: 待机\n当前文件: 未开启监控\n已收数据: 0 包 | 速率: 0 Hz" />
    </LinearLayout>

    <TextView
        android:id="@+id/logPath"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColor="#888888"
        android:textSize="12sp" />

</LinearLayout>
